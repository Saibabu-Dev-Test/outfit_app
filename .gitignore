# Written by CI from the GEMINI_API_KEY secret. The committed copy is an empty stub:
# never commit a real key here (the repo is public).
src/config/ai.generated.ts
web/dist/
.eslintcache

# Generated by scripts/build-hosting.js (source: web/public/get and web/public/icons)
hosting-public/get/
hosting-public/icons/

# Release signing keys come from CI secrets (RELEASE_KEYSTORE_BASE64), never from the repo
*.p12
*.jks
