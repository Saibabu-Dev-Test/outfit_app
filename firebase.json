{
  "hosting": {
    "public": "hosting-public",
    "predeploy": [
      "node scripts/build-hosting.js"
    ],
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "redirects": [
      {
        "source": "/Outfit.apk",
        "destination": "https://github.com/Saibabu-Dev-Test/outfit_app/releases/latest/download/Outfit.apk",
        "type": 302
      },
      {
        "source": "/Outfit-universal.apk",
        "destination": "https://github.com/Saibabu-Dev-Test/outfit_app/releases/latest/download/Outfit-universal.apk",
        "type": 302
      },
      {
        "source": "/og.png",
        "destination": "/icons/og.png",
        "type": 302
      },
      {
        "regex": "^(?:|[^/].*|/(?:|[^giprs].*|g(?:|[^e].*|e(?:|[^t].*|t(?:|[^/].*)))|i(?:|[^c].*|c(?:|[^o].*|o(?:|[^n].*|n(?:|[^s].*|s(?:|[^/].*)))))|p(?:|[^r].*|r(?:|[^i].*|i(?:|[^v].*|v(?:|[^a].*|a(?:|[^c].*|c(?:|[^y].*))))))|r(?:|[^o].*|o(?:|[^b].*|b(?:|[^o].*|o(?:|[^t].*|t(?:|[^s].*|s(?:|[^.].*|\\.(?:|[^t].*|t(?:|[^x].*|x(?:|[^t].*|t(?:.+))))))))))|s(?:|[^w].*|w(?:|[^.].*|\\.(?:|[^j].*|j(?:|[^s].*|s(?:.+)))))))$",
        "destination": "/get/",
        "type": 302
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
