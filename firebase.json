{
  "hosting": {
    "public": "hosting-public",
    "predeploy": [
      "node scripts/build-hosting.js"
    ],
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "redirects": [
      {
        "source": "/Outfit.apk",
        "destination": "https://github.com/Saibabu-Dev-Test/outfit_app/releases/latest/download/Outfit.apk",
        "type": 302
      },
      {
        "source": "/Outfit-universal.apk",
        "destination": "https://github.com/Saibabu-Dev-Test/outfit_app/releases/latest/download/Outfit-universal.apk",
        "type": 302
      },
      {
        "source": "/og.png",
        "destination": "/icons/og.png",
        "type": 302
      },
      {
        "regex": "^(?:|[^/].*|/(?:[^acgioprst].*|a(?:|[^bp].*|b(?:|[^o].*|o(?:|[^u].*|u(?:|[^t].*)))|p(?:|[^p].*|p(?:|[^\\-].*|-(?:|[^a].*|a(?:|[^d].*|d(?:|[^s].*|s(?:|[^.].*|\\.(?:|[^t].*|t(?:|[^x].*|x(?:|[^t].*|t(?:.+)))))))))))|c(?:|[^o].*|o(?:|[^n].*|n(?:|[^t].*|t(?:|[^a].*|a(?:|[^c].*|c(?:|[^t].*))))))|g(?:|[^e].*|e(?:|[^t].*|t(?:|[^/].*)))|i(?:|[^c].*|c(?:|[^o].*|o(?:|[^n].*|n(?:|[^s].*|s(?:|[^/].*)))))|o(?:|[^f].*|f(?:|[^f].*|f(?:|[^e].*|e(?:|[^r].*|r(?:|[^w].*|w(?:|[^a].*|a(?:|[^l].*|l(?:|[^l].*|l(?:|[^.].*|\\.(?:|[^t].*|t(?:|[^x].*|x(?:|[^t].*|t(?:.+)))))))))))))|p(?:|[^r].*|r(?:|[^i].*|i(?:|[^v].*|v(?:|[^a].*|a(?:|[^c].*|c(?:|[^y].*))))))|r(?:|[^o].*|o(?:|[^b].*|b(?:|[^o].*|o(?:|[^t].*|t(?:|[^s].*|s(?:|[^.].*|\\.(?:|[^t].*|t(?:|[^x].*|x(?:|[^t].*|t(?:.+))))))))))|s(?:|[^w].*|w(?:|[^.].*|\\.(?:|[^j].*|j(?:|[^s].*|s(?:.+)))))|t(?:|[^e].*|e(?:|[^r].*|r(?:|[^m].*|m(?:|[^s].*))))))$",
        "destination": "/get/",
        "type": 302
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
