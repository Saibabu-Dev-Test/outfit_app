<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Daily reminders: re-armed after a reboot (inexact alarms, no exact-alarm permission) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Nearby circles: approximate location only (rounded to ~100 m before saving) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- No storage / media permissions: photos come from the system photo picker and camera
         capture goes to the app's cache via FileProvider (react-native-image-picker, saveToPhotos off) -->

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
      <!-- AdMob App ID (real). Keep equal to app.json "react-native-google-mobile-ads".android_app_id
           and REAL_ADS.appId in src/config/ads.ts. Debug builds still use Google's TEST ad UNIT ids
           (src/config/ads.ts), which is the recommended setup. Never remove: the SDK crashes at start. -->
      <meta-data
        android:name="com.google.android.gms.ads.APPLICATION_ID"
        android:value="ca-app-pub-8006246175093661~4589468267"
        tools:replace="android:value" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Circle invite links: outfit://join/CODE (CircleInviteLink.tsx) -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="outfit" android:host="join" />
        </intent-filter>
      </activity>

      <!-- Daily reminders (8 AM / 1 PM / 7 PM) + re-arm after boot, update or clock change -->
      <receiver
        android:name=".DailyNotificationReceiver"
        android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.QUICKBOOT_POWERON" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          <action android:name="android.intent.action.TIME_SET" />
          <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        </intent-filter>
      </receiver>

      <!-- Push (FCM): shown on the "activity" channel; a tap opens the app with the data payload
           (outfit_payload) as intent extras, which MainActivity hands to the app -->
      <service
        android:name=".OutfitMessagingService"
        android:exported="false">
        <intent-filter>
          <action android:name="com.google.firebase.MESSAGING_EVENT" />
        </intent-filter>
      </service>
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_channel_id"
        android:value="activity" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_stat_outfit" />

      <!-- Download the ML Kit subject segmentation model with the app (photo background) -->
      <meta-data
        android:name="com.google.mlkit.vision.DEPENDENCIES"
        android:value="subject_segment" />

      <!-- Camera capture (react-native-image-picker) and in-app update APKs (xml/file_paths) -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.provider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>

    </application>
</manifest>
