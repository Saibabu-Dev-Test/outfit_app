rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    // Only sessions signed in with Google count. An email+password-only session
    // (someone who knows the Gmail address + password but doesn't own the Gmail,
    // or a REST script) can't read or write anything.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function me() {
      return request.auth.uid;
    }
    // users/{uid}.role == 'admin' is set by hand in the Firebase console
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function circleData(cid) {
      return get(/databases/$(db)/documents/circles/$(cid)).data;
    }
    function isMember(cid) {
      return signedIn() && me() in circleData(cid).memberIds;
    }
    function isCircleOwner(cid) {
      return signedIn() && circleData(cid).ownerId == me();
    }
    // users/{uid}.phone (login key) may only be set to a number this user owns in phones/
    function phoneOk(oldPhone) {
      return request.resource.data.get('phone', null) == oldPhone
        || get(/databases/$(db)/documents/phones/$(request.resource.data.phone)).data.uid == me();
    }

    // New comment {userId, userName, userAvatar, text, createdAt} by me, bad-word checked
    function commentOk() {
      return request.resource.data.keys().hasOnly(['userId', 'userName', 'userAvatar', 'text', 'createdAt'])
        && request.resource.data.userId == me()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time
        && (request.resource.data.get('userAvatar', null) == null
            || (request.resource.data.userAvatar is string
                && request.resource.data.userAvatar.size() <= 60000))
        // Worst abusive words (the app filters a longer list before sending)
        && !request.resource.data.text.lower().matches('(([a-z]|[^a-z])*[^a-z])?(fuck[a-z]*|motherfucker[a-z]*|bitch(es)?|cunts?|nigg(er|a)s?|faggots?|madarchod|behenchod|bhenchod|chutiy[ae]|bhosdike|lanja|lanjakodaka|dengu|puku|modda|randi|gandu|lavda)([^a-z]([a-z]|[^a-z])*)?');
    }

    // ── Rewards helpers (daily tasks, points, weekly celebrities) ─────────
    // Days in a Mon-Sun week with all 3 tasks done to become a weekly celebrity.
    // Keep in sync with WEEKLY_REQUIRED_DAYS in src/services/rewardsApi.ts
    function weeklyRequiredDays() {
      return 7;
    }
    function isDateKey(key) {
      return key is string && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // 'YYYY-MM-DD' -> 00:00 UTC of that day
    function dateTs(key) {
      return timestamp.date(int(key.split('-')[0]), int(key.split('-')[1]), int(key.split('-')[2]));
    }
    // 1970-01-05 was a Monday (4 days after the epoch)
    function isMonday(key) {
      return dateTs(key).toMillis() % 604800000 == 345600000;
    }
    function dayPath(uid, day) {
      return /databases/$(db)/documents/users/$(uid)/days/$(day);
    }
    function fullDay(d) {
      return d.get('opened', false) == true
        && d.get('voted', false) == true
        && d.get('uploaded', false) == true;
    }
    // 10 per task, +20 when all 3 are done (same as dayScore in rewardsApi.ts)
    function dayScore(d) {
      return (d.get('opened', false) == true ? 10 : 0)
        + (d.get('voted', false) == true ? 10 : 0)
        + (d.get('uploaded', false) == true ? 10 : 0)
        + (fullDay(d) ? 20 : 0);
    }
    function scoreBefore(uid, day) {
      return exists(dayPath(uid, day)) ? dayScore(get(dayPath(uid, day)).data) : 0;
    }
    function scoreAfter(uid, day) {
      return existsAfter(dayPath(uid, day)) ? dayScore(getAfter(dayPath(uid, day)).data) : 0;
    }
    // users.points may only grow by what users/{uid}/days/{pointsDay} gains in the same write
    function pointsOk() {
      let newP = request.resource.data.get('points', 0);
      let oldP = resource.data.get('points', 0);
      let day = request.resource.data.get('pointsDay', '');
      return newP == oldP
        || (isDateKey(day)
            && newP > oldP
            && newP - oldP == scoreAfter(me(), day) - scoreBefore(me(), day));
    }
    // users.referralCode is set once, together with referralCodes/{code} -> this user
    function referralCodeOk() {
      let oldC = resource.data.get('referralCode', null);
      let newC = request.resource.data.get('referralCode', null);
      return newC == oldC
        || (oldC == null
            && newC is string
            && getAfter(/databases/$(db)/documents/referralCodes/$(newC)).data.uid == me());
    }

    // ── Users ────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn()
        && (me() == uid || resource.data.isPublic == true || isAdmin());
      // Users write their own doc but can never set or change role
      allow create: if signedIn() && me() == uid
        && !('role' in request.resource.data)
        && phoneOk(null)
        && request.resource.data.get('points', 0) == 0
        && !('referralCode' in request.resource.data);
      allow update: if signedIn() && me() == uid
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && phoneOk(resource.data.get('phone', null))
        && pointsOk()
        && referralCodeOk();
      // Referral reward: a newly signed-up user adds exactly REFERRAL_POINTS (50) to the referrer's
      // points, only in the same write that creates referrals/{newUid} naming this referrer
      // (that doc is create-only, so it happens once per new user; never to yourself)
      allow update: if signedIn() && me() != uid
        && onlyChanged(['points'])
        && request.resource.data.get('points', 0) == resource.data.get('points', 0) + 50
        && !exists(/databases/$(db)/documents/referrals/$(request.auth.uid))
        && existsAfter(/databases/$(db)/documents/referrals/$(request.auth.uid))
        && getAfter(/databases/$(db)/documents/referrals/$(request.auth.uid)).data.referrerId == uid
        && getAfter(/databases/$(db)/documents/referrals/$(request.auth.uid)).data.get('pointsAwarded', false) == true;
      allow delete: if signedIn() && me() == uid;
    }

    // ── Daily tasks: users/{uid}/days/{yyyy-mm-dd} {opened, voted, uploaded, updatedAt} ──
    // Only around that date (any timezone), and a done task can't be undone.
    match /users/{uid}/days/{day} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && isDateKey(day)
        && request.time > dateTs(day) - duration.value(14, 'h')
        && request.time < dateTs(day) + duration.value(38, 'h')
        && request.resource.data.keys().hasOnly(['opened', 'voted', 'uploaded', 'updatedAt', 'aiCount'])
        // AI stylist messages used that day (0..20, never goes down)
        && request.resource.data.get('aiCount', 0) is int
        && request.resource.data.get('aiCount', 0) >= 0
        && request.resource.data.get('aiCount', 0) <= 20
        && (resource == null || request.resource.data.get('aiCount', 0) >= resource.data.get('aiCount', 0))
        && request.resource.data.get('opened', false) is bool
        && request.resource.data.get('voted', false) is bool
        && request.resource.data.get('uploaded', false) is bool
        && (resource == null
            || ((resource.data.get('opened', false) == false || request.resource.data.get('opened', false) == true)
                && (resource.data.get('voted', false) == false || request.resource.data.get('voted', false) == true)
                && (resource.data.get('uploaded', false) == false || request.resource.data.get('uploaded', false) == true)));
      allow delete: if false;
    }

    // ── Likes list: users/{uid}/liked/{p_postId | w_wardrobeId} {kind, refId, createdAt} ──
    // Written by the owner in the same write as the like itself.
    match /users/{uid}/liked/{key} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['kind', 'refId', 'createdAt'])
        && request.resource.data.kind in ['post', 'wardrobe']
        && request.resource.data.refId is string
        && key == (request.resource.data.kind == 'post' ? 'p_' : 'w_') + request.resource.data.refId;
      allow delete: if signedIn() && me() == uid;
    }

    // ── Activity ("who liked my photos"): users/{uid}/activity/{autoId} ──
    // {type, actorId, actorName, actorAvatar, targetKind, targetId, thumbnail, text, createdAt}
    // Written by the person who liked / disliked / commented / followed (never by the owner);
    // only the owner reads and deletes. No updates.
    match /users/{uid}/activity/{aid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create: if signedIn()
        && request.resource.data.actorId == me()
        && uid != me()
        && request.resource.data.keys().hasOnly(['type', 'actorId', 'actorName', 'actorAvatar', 'targetKind', 'targetId', 'thumbnail', 'text', 'createdAt'])
        && request.resource.data.type in ['like', 'dislike', 'comment', 'follow', 'feedback', 'referral']
        && request.resource.data.createdAt == request.time
        && (request.resource.data.get('actorName', null) == null
            || (request.resource.data.actorName is string && request.resource.data.actorName.size() <= 60))
        && (request.resource.data.get('actorAvatar', null) == null
            || (request.resource.data.actorAvatar is string && request.resource.data.actorAvatar.size() <= 60000))
        && (request.resource.data.get('targetKind', null) == null
            || request.resource.data.targetKind in ['post', 'wardrobe'])
        && (request.resource.data.get('targetId', null) == null
            || (request.resource.data.targetId is string && request.resource.data.targetId.size() <= 128))
        && (request.resource.data.get('thumbnail', null) == null
            || (request.resource.data.thumbnail is string && request.resource.data.thumbnail.size() <= 2000))
        && (request.resource.data.get('text', null) == null
            || (request.resource.data.text is string && request.resource.data.text.size() <= 120));
      allow update: if false;
    }

    // ── Public list of admin uids: config/admins {uids, updatedAt} ──
    // Read by any signed-in user (feedback notifies the admins); written only by an admin
    // (AdminScreen adds the admin who opens it).
    match /config/admins {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uids', 'updatedAt'])
        && request.resource.data.uids is list
        && request.resource.data.uids.size() <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ── Follow: users/{target}/followers/{follower} + users/{follower}/following/{target} ──
    // Only the follower writes, and both docs change together (checked with getAfter/existsAfter).
    function followEntryOk() {
      return request.resource.data.keys().hasOnly(['name', 'avatar', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && (request.resource.data.get('avatar', null) == null
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 60000));
    }
    function followPath(target, follower) {
      return /databases/$(db)/documents/users/$(target)/followers/$(follower);
    }
    function followingPath(follower, target) {
      return /databases/$(db)/documents/users/$(follower)/following/$(target);
    }
    // Lists of a private profile: only the owner (and the follower for their own doc)
    function profileOpen(uid) {
      return me() == uid
        || get(/databases/$(db)/documents/users/$(uid)).data.get('isPublic', true) != false;
    }
    match /users/{uid}/followers/{follower} {
      allow get: if signedIn() && (me() == follower || profileOpen(uid));
      allow list: if signedIn() && profileOpen(uid);
      allow create: if signedIn() && me() == follower && follower != uid
        && followEntryOk()
        && existsAfter(followingPath(follower, uid));
      allow delete: if signedIn() && me() == follower
        && !existsAfter(followingPath(follower, uid));
      allow update: if false;
    }
    match /users/{uid}/following/{target} {
      allow get: if signedIn() && (me() == uid || profileOpen(uid));
      allow list: if signedIn() && profileOpen(uid);
      allow create: if signedIn() && me() == uid && target != uid
        && followEntryOk()
        && existsAfter(followPath(target, uid));
      allow delete: if signedIn() && me() == uid
        && !existsAfter(followPath(target, uid));
      allow update: if false;
    }

    // ── "Wear today" votes on someone's wardrobe: users/{uid}/wearVotes/{date}_{voterId} ──
    // {voterId, itemId, date, updatedAt}. Like a daily vote: one doc per voter per owner per day
    // (voting for another item overwrites it). Only the voter writes their own doc; nobody votes on
    // their own clothes; only public items of an open (public) profile; only around that date.
    // Counts are readable by the owner and by anyone who can see the profile.
    match /users/{uid}/wearVotes/{vid} {
      function wearItem() {
        return get(/databases/$(db)/documents/wardrobe/$(request.resource.data.itemId)).data;
      }
      allow read: if signedIn() && (me() == uid || profileOpen(uid));
      allow create, update: if signedIn()
        && me() != uid
        && profileOpen(uid)
        && request.resource.data.keys().hasOnly(['voterId', 'itemId', 'date', 'updatedAt'])
        && request.resource.data.voterId == me()
        && isDateKey(request.resource.data.date)
        && vid == request.resource.data.date + '_' + me()
        && request.time > dateTs(request.resource.data.date) - duration.value(14, 'h')
        && request.time < dateTs(request.resource.data.date) + duration.value(38, 'h')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() > 0
        && request.resource.data.itemId.size() <= 128
        && wearItem().userId == uid
        && wearItem().isPublic == true;
      allow delete: if signedIn() && resource.data.voterId == me();
    }

    // ── Week counter: users/{uid}/weeks/{mondayKey} {fullDays, lastDay, updatedAt} ──
    // +1 only in the same write that makes lastDay (a day of that week) fully done.
    function weekCountOk(uid, week, oldCount) {
      let day = request.resource.data.get('lastDay', '');
      return isDateKey(week) && isMonday(week) && isDateKey(day)
        && request.resource.data.keys().hasOnly(['fullDays', 'lastDay', 'updatedAt'])
        && request.resource.data.fullDays == oldCount + 1
        && dateTs(day) >= dateTs(week)
        && dateTs(day) < dateTs(week) + duration.value(7, 'd')
        && existsAfter(dayPath(uid, day))
        && fullDay(getAfter(dayPath(uid, day)).data)
        && !(exists(dayPath(uid, day)) && fullDay(get(dayPath(uid, day)).data));
    }
    match /users/{uid}/weeks/{week} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid && weekCountOk(uid, week, 0);
      allow update: if signedIn() && me() == uid
        && request.resource.data.lastDay != resource.data.get('lastDay', '')
        && weekCountOk(uid, week, resource.data.get('fullDays', 0));
      allow delete: if false;
    }

    // ── Phone registry: phones/{digits} -> {uid, createdAt} ──────────────
    // One account per mobile number. Get by id only (no listing).
    match /phones/{digits} {
      allow get: if signedIn();
      allow list: if false;
      // create() only runs when the doc doesn't exist yet
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if signedIn() && resource.data.uid == me()
        && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ── Daily colour votes (Phase 1) ────────────────────────────────────
    // Home writes votes/top_colors_{date}_{uid} with {systemId, color, userId, voterGender, voterName, voterAge, date, timestamp}
    match /votes/{voteId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == me()
        && request.resource.data.systemId == 'top_colors'
        && voteId == 'top_colors_' + request.resource.data.date + '_' + me()
        // Name and age shown in the Boys / Girls voter lists
        && (request.resource.data.get('voterName', null) == null
            || (request.resource.data.voterName is string && request.resource.data.voterName.size() <= 60))
        && (request.resource.data.get('voterAge', null) == null
            || (request.resource.data.voterAge is int
                && request.resource.data.voterAge >= 0
                && request.resource.data.voterAge < 130));
      allow delete: if false;
    }

    // ── Wardrobe (Phase 1) ──────────────────────────────────────────────
    match /wardrobe/{itemId} {
      allow read: if signedIn()
        && (resource.data.userId == me() || resource.data.isPublic == true);
      allow create: if signedIn() && request.resource.data.userId == me();
      allow update: if signedIn() && resource.data.userId == me()
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == me();

      // ── Likes and comments on public wardrobe photos in the feed ──
      function itemData() {
        return get(/databases/$(db)/documents/wardrobe/$(itemId)).data;
      }
      function itemVisible() {
        return itemData().userId == me() || itemData().isPublic == true;
      }
      match /likes/{likerId} {
        allow read: if signedIn() && itemVisible();
        allow create: if signedIn() && likerId == me() && itemVisible()
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if signedIn() && likerId == me();
        allow update: if false;
      }
      // ── Dislikes: one doc per user; can't be created while the user's like exists
      //    (the app removes the like in the same batch: like XOR dislike) ──
      match /dislikes/{dislikerId} {
        allow read: if signedIn() && itemVisible();
        allow create: if signedIn() && dislikerId == me() && itemVisible()
          && request.resource.data.keys().hasOnly(['createdAt'])
          && !existsAfter(/databases/$(db)/documents/wardrobe/$(itemId)/likes/$(request.auth.uid));
        allow delete: if signedIn() && dislikerId == me();
        allow update: if false;
      }
      match /comments/{cid} {
        allow read: if signedIn() && itemVisible();
        allow create: if signedIn() && itemVisible() && commentOk();
        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.userId == me() || itemData().userId == me() || isAdmin());
      }
    }

    // ── Invite codes: inviteCodes/{code} -> {circleId, createdBy} ──────────
    // Anyone signed in can look up one code they know; nobody can list them.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && getAfter(/databases/$(db)/documents/circles/$(request.resource.data.circleId)).data.ownerId == me()
        && getAfter(/databases/$(db)/documents/circles/$(request.resource.data.circleId)).data.inviteCode == code;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.createdBy == me() || isAdmin());
    }

    // ── Circles ─────────────────────────────────────────────────────────
    match /circles/{cid} {
      // Optional distance limit: public circles only, needs a location, 1-50 km
      function validRadius(d) {
        return d.get('radiusKm', null) == null
          || (d.radiusKm is number && d.radiusKm > 0 && d.radiusKm <= 50
              && d.isPrivate == false
              && d.get('location', null) != null
              && d.get('cosLat', null) is number);
      }
      function joinedWithCode() {
        let j = request.resource.data.get('lastJoin', {});
        return j.get('uid', '') == me() && j.get('code', '') == resource.data.inviteCode;
      }
      // Approximate distance (equirectangular, cosLat stored with the location) with ~0.5 km slack
      // for the ~100 m rounding of both points. The location comes from the phone.
      function joinedNearby() {
        let j = request.resource.data.get('lastJoin', {});
        let c = resource.data;
        let r = c.get('radiusKm', 0) + 0.5;
        return j.get('uid', '') == me()
          && j.get('lat', null) is number && j.get('lng', null) is number
          && c.get('location', null) != null
          && math.pow((j.lat - c.location.lat) * 111.32, 2)
             + math.pow((j.lng - c.location.lng) * 111.32 * c.get('cosLat', 1.0), 2) <= r * r;
      }

      allow read: if signedIn()
        && (resource.data.isPrivate == false || me() in resource.data.memberIds || isAdmin());

      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()]
        && request.resource.data.isPrivate is bool
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        // Nearby: isPublic must match isPrivate; location is optional (~100 m, set by the app)
        && request.resource.data.get('isPublic', !request.resource.data.isPrivate) == !request.resource.data.isPrivate
        && (request.resource.data.get('geohash', null) == null
            || (request.resource.data.geohash is string && request.resource.data.geohash.size() <= 12))
        && (request.resource.data.get('location', null) == null
            || (request.resource.data.location.lat is number && request.resource.data.location.lng is number))
        && validRadius(request.resource.data);

      allow update: if signedIn() && (
        // Owner: anything except ownership (incl. Public <-> Private and the Nearby location)
        (resource.data.ownerId == me() && request.resource.data.ownerId == resource.data.ownerId
            && validRadius(request.resource.data))
        // Admin: only Public <-> Private and the Nearby location (isPublic must match isPrivate)
        || (isAdmin()
            && onlyChanged(['isPrivate', 'isPublic', 'location', 'geohash', 'cosLat', 'radiusKm'])
            && request.resource.data.isPrivate is bool
            && request.resource.data.get('isPublic', !request.resource.data.isPrivate) == !request.resource.data.isPrivate
            && validRadius(request.resource.data))
        // Join: add only yourself.
        //   Invite code (any circle, any distance): lastJoin = {uid: me, code: inviteCode}
        //   Public, no distance limit: anyone
        //   Public with radiusKm: lastJoin = {uid: me, lat, lng} within radiusKm of the circle
        || (onlyChanged(['memberIds', 'lastJoin'])
            && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([me()].toSet())
            && ((resource.data.isPrivate == false && resource.data.get('radiusKm', null) == null)
                || joinedWithCode()
                || (resource.data.isPrivate == false && joinedNearby())))
        // Leave: remove only yourself (the owner deletes instead of leaving)
        || (onlyChanged(['memberIds'])
            && me() in resource.data.memberIds
            && resource.data.ownerId != me()
            && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([me()].toSet()))
        // Members bump lastMessageAt when they send
        || (onlyChanged(['lastMessageAt']) && me() in resource.data.memberIds)
      );

      allow delete: if signedIn() && (resource.data.ownerId == me() || isAdmin());

      // ── Messages ──
      match /messages/{mid} {
        allow read: if isMember(cid) || isAdmin();
        allow create: if isMember(cid)
          && request.resource.data.userId == me()
          && request.resource.data.type in ['text', 'image', 'poll']
          && (request.resource.data.type != 'poll'
              || (request.resource.data.poll.options.size() >= 2
                  && request.resource.data.poll.options.size() <= 6));
        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.userId == me() || isCircleOwner(cid) || isAdmin());

        // ── Poll votes: one doc per voter, so a new vote replaces the old one ──
        match /votes/{voterId} {
          allow read: if isMember(cid) || isAdmin();
          allow create, update: if isMember(cid)
            && voterId == me()
            && request.resource.data.keys().hasOnly(['optionIndex', 'updatedAt'])
            && request.resource.data.optionIndex is int
            && request.resource.data.optionIndex >= 0
            && request.resource.data.optionIndex
               < get(/databases/$(db)/documents/circles/$(cid)/messages/$(mid)).data.poll.options.size();
          // Own vote, or cleanup by the poll author, circle owner or admin
          allow delete: if signedIn()
            && (voterId == me()
                || isCircleOwner(cid)
                || isAdmin()
                || get(/databases/$(db)/documents/circles/$(cid)/messages/$(mid)).data.userId == me());
        }

        // ── Like / dislike: one doc per member, changeable ──
        match /reactions/{uid} {
          allow read: if isMember(cid) || isAdmin();
          allow create, update: if isMember(cid)
            && uid == me()
            && request.resource.data.keys().hasOnly(['type', 'updatedAt'])
            && request.resource.data.type in ['like', 'dislike'];
          allow delete: if signedIn()
            && (uid == me()
                || isCircleOwner(cid)
                || isAdmin()
                || get(/databases/$(db)/documents/circles/$(cid)/messages/$(mid)).data.userId == me());
        }

        // ── Comments on a photo / A-F post ──
        match /comments/{commentId} {
          allow read: if isMember(cid) || isAdmin();
          allow create: if isMember(cid) && commentOk();
          allow update: if false;
          allow delete: if signedIn()
            && (resource.data.userId == me()
                || isCircleOwner(cid)
                || isAdmin()
                || get(/databases/$(db)/documents/circles/$(cid)/messages/$(mid)).data.userId == me());
        }
      }
    }

    // ── Public feed ─────────────────────────────────────────────────────
    match /posts/{postId} {
      function postPath() {
        return /databases/$(db)/documents/posts/$(postId);
      }
      function likePath() {
        return /databases/$(db)/documents/posts/$(postId)/likes/$(request.auth.uid);
      }
      function commentPath(cid) {
        return /databases/$(db)/documents/posts/$(postId)/comments/$(cid);
      }
      // likeCount changes by exactly 1, together with the liker's own like doc
      function likeUpdate() {
        return onlyChanged(['likeCount'])
          && (
            (request.resource.data.likeCount == resource.data.likeCount + 1
              && !exists(likePath()) && existsAfter(likePath()))
            || (request.resource.data.likeCount == resource.data.likeCount - 1
              && exists(likePath()) && !existsAfter(likePath()))
          );
      }
      // commentCount changes by exactly 1, together with the comment named in lastCommentId
      // (posts without commentCount count as 0)
      function commentCountUpdate() {
        let cid = request.resource.data.lastCommentId;
        let before = resource.data.get('commentCount', 0);
        return onlyChanged(['commentCount', 'lastCommentId'])
          && cid is string
          && (
            (request.resource.data.commentCount == before + 1
              && !exists(commentPath(cid)) && existsAfter(commentPath(cid)))
            || (request.resource.data.commentCount == before - 1
              && before > 0
              && exists(commentPath(cid)) && !existsAfter(commentPath(cid)))
          );
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == me()
        && request.resource.data.isPublic == true
        && request.resource.data.likeCount == 0
        && request.resource.data.get('commentCount', 0) == 0
        && request.resource.data.imageData is string
        // 2-6 photo "vote A/B/C" posts keep photos B.. in morePhotos
        && (request.resource.data.get('morePhotos', null) == null
            || (request.resource.data.morePhotos is list
                && request.resource.data.morePhotos.size() >= 1
                && request.resource.data.morePhotos.size() <= 5));
      allow update: if signedIn() && (likeUpdate() || commentCountUpdate());
      allow delete: if signedIn() && (resource.data.userId == me() || isAdmin());

      match /likes/{likerId} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && likerId == me();
        allow update: if false;
      }

      // ── Dislikes: one doc per user; can't be created while the user's like exists
      //    (the app removes the like + likeCount in the same transaction: like XOR dislike) ──
      match /dislikes/{dislikerId} {
        allow read: if signedIn();
        allow create: if signedIn() && dislikerId == me()
          && exists(postPath())
          && request.resource.data.keys().hasOnly(['createdAt'])
          && !existsAfter(likePath());
        allow delete: if signedIn() && dislikerId == me();
        allow update: if false;
      }

      // ── A/B/C votes on multi-photo posts: one doc per voter, changeable ──
      match /votes/{voterId} {
        function photoCount() {
          return get(postPath()).data.get('morePhotos', []).size() + 1;
        }
        allow read: if signedIn();
        allow create, update: if signedIn()
          && voterId == me()
          && request.resource.data.keys().hasOnly(['option', 'updatedAt'])
          && photoCount() >= 2
          && request.resource.data.option in ['A', 'B', 'C', 'D', 'E', 'F'][0:photoCount()];
        allow delete: if signedIn() && (voterId == me() || get(postPath()).data.userId == me() || isAdmin());
      }

      // ── Comments: posts/{postId}/comments/{cid} {userId, userName, userAvatar, text, createdAt} ──
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && exists(postPath())
          && commentOk();
        allow update: if false;
        // Comment author, post owner or admin
        allow delete: if signedIn()
          && (resource.data.userId == me()
              || get(postPath()).data.userId == me()
              || isAdmin());
      }
    }

    // ── Referral codes: referralCodes/{code} -> {uid, createdAt} (one per user) ──
    match /referralCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == me()
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('referralCode', '') == code;
      allow update, delete: if false;
    }

    // ── Referrals: referrals/{newUid} {referrerId, code, createdAt, pointsAwarded}, written once by
    // the new user, together with +50 on users/{referrerId}.points (see the users rule).
    match /referrals/{newUid} {
      allow get: if signedIn() && (me() == newUid || resource.data.referrerId == me());
      allow list: if signedIn() && resource.data.referrerId == me();
      allow create: if signedIn() && me() == newUid
        && request.resource.data.keys().hasOnly(['referrerId', 'code', 'createdAt', 'pointsAwarded'])
        // pointsAwarded: true only when the referrer's points go up by 50 in the same write
        && (request.resource.data.get('pointsAwarded', false) == false
            || (request.resource.data.pointsAwarded == true
                && getAfter(/databases/$(db)/documents/users/$(request.resource.data.referrerId)).data.get('points', 0)
                   == get(/databases/$(db)/documents/users/$(request.resource.data.referrerId)).data.get('points', 0) + 50))
        && request.resource.data.referrerId is string
        && request.resource.data.referrerId != me()
        && request.resource.data.code is string
        && request.resource.data.createdAt == request.time
        && get(/databases/$(db)/documents/referralCodes/$(request.resource.data.code)).data.uid
           == request.resource.data.referrerId
        // only right after sign-up
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.createdAt
           > request.time - duration.value(1, 'd');
      allow update, delete: if false;
    }

    // ── Weekly celebrities: weeklyStars/{mondayKey}/members/{uid} ──
    match /weeklyStars/{week} {
      match /members/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && me() == uid
          && isDateKey(week) && isMonday(week)
          && request.resource.data.keys().hasOnly(['name', 'avatar', 'completedDays', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 60
          && (request.resource.data.get('avatar', null) == null
              || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 60000))
          && request.resource.data.createdAt == request.time
          && request.resource.data.completedDays is int
          && request.resource.data.completedDays
             == get(/databases/$(db)/documents/users/$(request.auth.uid)/weeks/$(week)).data.fullDays
          && request.resource.data.completedDays >= weeklyRequiredDays();
        allow update: if false;
        allow delete: if signedIn() && (me() == uid || isAdmin());
      }
    }

    // ── Reports (moderation) ────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == me()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ── Feedback & suggestions ──────────────────────────────────────────
    // feedback/{autoId} {uid, name, type, text, image, appVersion, platform, createdAt, status}
    // Anyone signed in with Google writes their own (status 'new'); only admins read them
    // and change the status. Nobody else can read another user's feedback.
    match /feedback/{fid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'type', 'text', 'image', 'appVersion', 'platform', 'createdAt', 'status'])
        && request.resource.data.keys().hasAll(['uid', 'type', 'text', 'createdAt', 'status'])
        && request.resource.data.uid == me()
        && request.resource.data.type in ['Suggestion', 'Complaint', 'Bug', 'Other']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && (request.resource.data.get('name', null) == null
            || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
        && (request.resource.data.get('image', null) == null
            || (request.resource.data.image is string && request.resource.data.image.size() <= 145000))
        && (request.resource.data.get('appVersion', null) == null
            || (request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20))
        && (request.resource.data.get('platform', null) == null
            || (request.resource.data.platform is string && request.resource.data.platform.size() <= 20))
        // Same worst-words check as comments (the app filters a longer list before sending)
        && !request.resource.data.text.lower().matches('(([a-z]|[^a-z])*[^a-z])?(fuck[a-z]*|motherfucker[a-z]*|bitch(es)?|cunts?|nigg(er|a)s?|faggots?|madarchod|behenchod|bhenchod|chutiy[ae]|bhosdike|lanja|lanjakodaka|dengu|puku|modda|randi|gandu|lavda)([^a-z]([a-z]|[^a-z])*)?');
      allow read: if isAdmin();
      allow update: if isAdmin()
        && onlyChanged(['status'])
        && request.resource.data.status in ['new', 'read', 'done'];
      allow delete: if isAdmin();
    }
  }
}
