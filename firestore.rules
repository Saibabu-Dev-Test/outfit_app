rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    // Only sessions signed in with Google count. An email+password-only session
    // (someone who knows the Gmail address + password but doesn't own the Gmail,
    // or a REST script) can't read or write anything.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function me() {
      return request.auth.uid;
    }
    // users/{uid}.role == 'admin' is set by hand in the Firebase console
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function circleData(cid) {
      return get(/databases/$(db)/documents/circles/$(cid)).data;
    }
    function isMember(cid) {
      return signedIn() && me() in circleData(cid).memberIds;
    }
    function isCircleOwner(cid) {
      return signedIn() && circleData(cid).ownerId == me();
    }
    // users/{uid}.phone (login key) may only be set to a number this user owns in phones/
    function phoneOk(oldPhone) {
      return request.resource.data.get('phone', null) == oldPhone
        || get(/databases/$(db)/documents/phones/$(request.resource.data.phone)).data.uid == me();
    }

    // New comment {userId, userName, userAge?, userAvatar, text, createdAt} by me, bad-word checked
    function commentOk() {
      return request.resource.data.keys().hasOnly(['userId', 'userName', 'userAge', 'userAvatar', 'text', 'createdAt', 'parentId'])
        && (request.resource.data.get('userAge', null) == null
            || (request.resource.data.userAge is int
                && request.resource.data.userAge >= 0
                && request.resource.data.userAge < 130))
        && request.resource.data.userId == me()
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time
        // Optional reply parent (one level; the post / wardrobe comment blocks check it exists)
        && (request.resource.data.get('parentId', null) == null
            || (request.resource.data.parentId is string
                && request.resource.data.parentId.size() <= 64))
        && (request.resource.data.get('userAvatar', null) == null
            || (request.resource.data.userAvatar is string
                && request.resource.data.userAvatar.size() <= 60000))
        // Worst abusive words (the app filters a longer list before sending)
        && !request.resource.data.text.lower().matches('(([a-z]|[^a-z])*[^a-z])?(fuck[a-z]*|motherfucker[a-z]*|bitch(es)?|cunts?|nigg(er|a)s?|faggots?|madarchod|behenchod|bhenchod|chutiy[ae]|bhosdike|lanja|lanjakodaka|dengu|puku|modda|randi|gandu|lavda)([^a-z]([a-z]|[^a-z])*)?');
    }

    // Same worst-words check as commentOk, for birthday wishes / birthday circle messages
    function noAbuse(t) {
      return !t.lower().matches('(([a-z]|[^a-z])*[^a-z])?(fuck[a-z]*|motherfucker[a-z]*|bitch(es)?|cunts?|nigg(er|a)s?|faggots?|madarchod|behenchod|bhenchod|chutiy[ae]|bhosdike|lanja|lanjakodaka|dengu|puku|modda|randi|gandu|lavda)([^a-z]([a-z]|[^a-z])*)?');
    }
    // 'YYYY-MM-DD' is the birthday 'MM-DD' (29 Feb birthdays also count on 28 Feb)
    function isBirthdayOn(md, day) {
      return day.matches('^[0-9]{4}-' + md + '$')
        || (md == '02-29' && day.matches('^[0-9]{4}-02-28$'));
    }
    // My opted-in birthday (birthdays/{me}) is `day`, and it is that day now (any Indian / nearby timezone)
    function myBirthdayNow(day) {
      let p = /databases/$(db)/documents/birthdays/$(request.auth.uid);
      return isDateKey(day)
        && exists(p)
        && isBirthdayOn(get(p).data.md, day)
        && request.time > dateTs(day) - duration.value(14, 'h')
        && request.time < dateTs(day) + duration.value(38, 'h');
    }

    // ── Rewards helpers (daily tasks, points, weekly celebrities) ─────────
    // Days in a Mon-Sun week with all 3 tasks done to become a weekly celebrity.
    // Keep in sync with WEEKLY_REQUIRED_DAYS in src/services/rewardsApi.ts
    function weeklyRequiredDays() {
      return 7;
    }
    function isDateKey(key) {
      return key is string && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // 'YYYY-MM-DD' -> 00:00 UTC of that day
    function dateTs(key) {
      return timestamp.date(int(key.split('-')[0]), int(key.split('-')[1]), int(key.split('-')[2]));
    }
    // 1970-01-05 was a Monday (4 days after the epoch)
    function isMonday(key) {
      return dateTs(key).toMillis() % 604800000 == 345600000;
    }
    function dayPath(uid, day) {
      return /databases/$(db)/documents/users/$(uid)/days/$(day);
    }
    function fullDay(d) {
      return d.get('opened', false) == true
        && d.get('voted', false) == true
        && d.get('uploaded', false) == true;
    }
    // 10 per task, +20 when all 3 are done (same as dayScore in rewardsApi.ts)
    function dayScore(d) {
      return (d.get('opened', false) == true ? 10 : 0)
        + (d.get('voted', false) == true ? 10 : 0)
        + (d.get('uploaded', false) == true ? 10 : 0)
        + (fullDay(d) ? 20 : 0);
    }
    function scoreBefore(uid, day) {
      return exists(dayPath(uid, day)) ? dayScore(get(dayPath(uid, day)).data) : 0;
    }
    function scoreAfter(uid, day) {
      return existsAfter(dayPath(uid, day)) ? dayScore(getAfter(dayPath(uid, day)).data) : 0;
    }
    // users.points may only grow by what users/{uid}/days/{pointsDay} gains in the same write
    function pointsOk() {
      let newP = request.resource.data.get('points', 0);
      let oldP = resource.data.get('points', 0);
      let day = request.resource.data.get('pointsDay', '');
      return newP == oldP
        || (isDateKey(day)
            && newP > oldP
            && newP - oldP == scoreAfter(me(), day) - scoreBefore(me(), day));
    }
    // ── Coins (src/config/coins.ts): users/{uid}/coinEvents/{type}_{targetId} {type, points, createdAt} ──
    // Fixed points per action. If you change them, change COIN_POINTS in src/config/coins.ts too.
    function coinPoints(t) {
      return t == 'like' ? 1 : (t == 'upload' ? 10 : (t == 'share' ? 50 : (t == 'task' ? 100 : -1)));
    }
    function coinEventPath(uid, eid) {
      return /databases/$(db)/documents/users/$(uid)/coinEvents/$(eid);
    }
    // users.coins may only grow by the points of the coin event (named in users.coinEvent)
    // that this same write creates (event docs are create-only, so each counts once)
    function coinsOk() {
      let newC = request.resource.data.get('coins', 0);
      let oldC = resource.data.get('coins', 0);
      let ev = request.resource.data.get('coinEvent', '');
      return newC == oldC
        || (ev is string
            && ev.matches('^(like|upload|share|task)_[A-Za-z0-9_-]{1,200}$')
            && !exists(coinEventPath(me(), ev))
            && existsAfter(coinEventPath(me(), ev))
            && newC == oldC + getAfter(coinEventPath(me(), ev)).data.points);
    }
    // ── Monthly tasks + rewards (src/config/monthlyTasks.ts) ──
    // If you change TASK_COINS / reward costs there, change coinPoints('task') / rewardCost here.
    function monthTaskOk(eid) {
      let parts = eid.split('_');
      return eid.matches('^task_[0-9]{4}-[0-9]{2}_(open20|vote15|upload10d|full7|like30|post10|share3)$')
        && request.time > timestamp.date(int(parts[1].split('-')[0]), int(parts[1].split('-')[1]), 1) - duration.value(14, 'h')
        && request.time < timestamp.date(int(parts[1].split('-')[0]), int(parts[1].split('-')[1]), 1) + duration.value(32, 'd');
    }
    function rewardCost(r) {
      return r == 'badge' ? 300 : (r == 'spotlight' ? 800 : (r == 'stylist' ? 1500 : (r == 'voucher' ? 3000 : -1)));
    }
    function rewardClaimPath(cid) {
      return /databases/$(db)/documents/rewardClaims/$(cid);
    }
    // users.coinsSpent: grows only by the cost of the reward claim this same write creates
    // (users.rewardClaim names it; claims are one per reward per month), never above users.coins
    function coinsSpentOk() {
      let newS = request.resource.data.get('coinsSpent', 0);
      let oldS = resource.data.get('coinsSpent', 0);
      let cid = request.resource.data.get('rewardClaim', '');
      return newS == oldS
        || (cid is string
            && cid.size() > 0
            && cid.size() <= 200
            && !exists(rewardClaimPath(cid))
            && existsAfter(rewardClaimPath(cid))
            && getAfter(rewardClaimPath(cid)).data.uid == me()
            && newS == oldS + getAfter(rewardClaimPath(cid)).data.cost
            && newS <= request.resource.data.get('coins', 0));
    }
    // ── Like coin levels (src/config/likeLevels.ts): users/{owner}.likesReceived ──
    // Another user adds exactly 1, only in the same write that creates their (create-only)
    // coin event like_{post|wardrobe}_{id} for a photo this user owns (users.likeEvent names it),
    // so each person's like on a photo counts once. The owner can never change it.
    function likeEventOwnedBy(ev, uid) {
      let parts = ev.split('_');
      return (parts[1] == 'post' && get(/databases/$(db)/documents/posts/$(parts[2])).data.userId == uid)
        || (parts[1] == 'wardrobe' && get(/databases/$(db)/documents/wardrobe/$(parts[2])).data.userId == uid);
    }
    function likesReceivedOk(uid) {
      let ev = request.resource.data.get('likeEvent', '');
      return ev is string
        && ev.matches('^like_(post|wardrobe)_[A-Za-z0-9-]{1,128}$')
        && request.resource.data.get('likesReceived', 0) == resource.data.get('likesReceived', 0) + 1
        && !exists(coinEventPath(me(), ev))
        && existsAfter(coinEventPath(me(), ev))
        && likeEventOwnedBy(ev, uid);
    }
    // users.referralCode is set once, together with referralCodes/{code} -> this user
    function referralCodeOk() {
      let oldC = resource.data.get('referralCode', null);
      let newC = request.resource.data.get('referralCode', null);
      return newC == oldC
        || (oldC == null
            && newC is string
            && getAfter(/databases/$(db)/documents/referralCodes/$(newC)).data.uid == me());
    }

    // ── Users ────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn()
        && (me() == uid || resource.data.isPublic == true || isAdmin());
      // Users write their own doc but can never set or change role
      allow create: if signedIn() && me() == uid
        && !('role' in request.resource.data)
        && phoneOk(null)
        && request.resource.data.get('points', 0) == 0
        && request.resource.data.get('coins', 0) == 0
        && request.resource.data.get('coinsSpent', 0) == 0
        && request.resource.data.get('likesReceived', 0) == 0
        && !('referralCode' in request.resource.data);
      allow update: if signedIn() && me() == uid
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && phoneOk(resource.data.get('phone', null))
        && pointsOk()
        && coinsOk()
        && coinsSpentOk()
        && request.resource.data.get('likesReceived', 0) == resource.data.get('likesReceived', 0)
        && referralCodeOk();
      // A like on this user's photo: +1 likesReceived (likesReceivedOk)
      allow update: if signedIn() && me() != uid
        && onlyChanged(['likesReceived', 'likeEvent'])
        && likesReceivedOk(uid);
      // Admin rejects a reward claim: coins back (coinsSpent - cost), in the same write that
      // marks that pending claim rejected (users.refundClaim names it)
      allow update: if signedIn() && isAdmin() && me() != uid
        && onlyChanged(['coinsSpent', 'refundClaim'])
        && get(rewardClaimPath(request.resource.data.refundClaim)).data.uid == uid
        && get(rewardClaimPath(request.resource.data.refundClaim)).data.status == 'pending'
        && getAfter(rewardClaimPath(request.resource.data.refundClaim)).data.status == 'rejected'
        && request.resource.data.coinsSpent == resource.data.get('coinsSpent', 0) - get(rewardClaimPath(request.resource.data.refundClaim)).data.cost;
      // Referral reward: a newly signed-up user adds exactly REFERRAL_POINTS (50) to the referrer's
      // points, only in the same write that creates referrals/{newUid} naming this referrer
      // (that doc is create-only, so it happens once per new user; never to yourself)
      allow update: if signedIn() && me() != uid
        && onlyChanged(['points'])
        && request.resource.data.get('points', 0) == resource.data.get('points', 0) + 50
        && !exists(/databases/$(db)/documents/referrals/$(request.auth.uid))
        && existsAfter(/databases/$(db)/documents/referrals/$(request.auth.uid))
        && getAfter(/databases/$(db)/documents/referrals/$(request.auth.uid)).data.referrerId == uid
        && getAfter(/databases/$(db)/documents/referrals/$(request.auth.uid)).data.get('pointsAwarded', false) == true;
      allow delete: if signedIn() && me() == uid;
    }

    // ── Daily tasks: users/{uid}/days/{yyyy-mm-dd} {opened, voted, uploaded, updatedAt} ──
    // Only around that date (any timezone), and a done task can't be undone.
    match /users/{uid}/days/{day} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && isDateKey(day)
        && request.time > dateTs(day) - duration.value(14, 'h')
        && request.time < dateTs(day) + duration.value(38, 'h')
        && request.resource.data.keys().hasOnly(['opened', 'voted', 'uploaded', 'updatedAt', 'aiCount'])
        // AI stylist messages used that day (0..20, never goes down)
        && request.resource.data.get('aiCount', 0) is int
        && request.resource.data.get('aiCount', 0) >= 0
        && request.resource.data.get('aiCount', 0) <= 20
        && (resource == null || request.resource.data.get('aiCount', 0) >= resource.data.get('aiCount', 0))
        && request.resource.data.get('opened', false) is bool
        && request.resource.data.get('voted', false) is bool
        && request.resource.data.get('uploaded', false) is bool
        && (resource == null
            || ((resource.data.get('opened', false) == false || request.resource.data.get('opened', false) == true)
                && (resource.data.get('voted', false) == false || request.resource.data.get('voted', false) == true)
                && (resource.data.get('uploaded', false) == false || request.resource.data.get('uploaded', false) == true)));
      allow delete: if false;
    }

    // ── Coin events: once per action + target, never changed or removed ──
    match /users/{uid}/coinEvents/{eid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['type', 'points', 'createdAt'])
        && request.resource.data.type in ['like', 'upload', 'share', 'task']
        && eid.matches('^' + request.resource.data.type + '_[A-Za-z0-9_-]{1,200}$')
        // Monthly task coins: task_{YYYY-MM}_{taskId}, only during that month (any timezone)
        && (request.resource.data.type != 'task' || monthTaskOk(eid))
        && request.resource.data.points == coinPoints(request.resource.data.type);
      allow update, delete: if false;
    }

    // ── Likes list: users/{uid}/liked/{p_postId | w_wardrobeId} {kind, refId, createdAt} ──
    // Written by the owner in the same write as the like itself.
    match /users/{uid}/liked/{key} {
      allow read: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['kind', 'refId', 'createdAt'])
        && request.resource.data.kind in ['post', 'wardrobe']
        && request.resource.data.refId is string
        && key == (request.resource.data.kind == 'post' ? 'p_' : 'w_') + request.resource.data.refId;
      allow delete: if signedIn() && me() == uid;
    }

    // ── Birthdays (opt-in "Show my birthday"): birthdays/{uid} {name, avatar, md: 'MM-DD', updatedAt} ──
    // Day + month only (never the year). Only the owner writes it, and md must match the owner's
    // own users/{uid}.dob. Everyone signed in can read the list (Home card, one query).
    match /birthdays/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'md', 'updatedAt'])
        && request.resource.data.md is string
        && request.resource.data.md.matches('^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('dob', '') is string
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('dob', '').matches('^[0-9]{4}-' + request.resource.data.md + '$')
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && (request.resource.data.get('avatar', null) == null
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 60000))
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && (me() == uid || isAdmin());
    }

    // ── Birthday wishes: birthdays/{uid}/wishes/{autoId} ──
    // {userId, userName, userAvatar, text, day, replyToUid, replyToName, createdAt}
    // day = that year's birthday; accepted from 7 days before until the day ends. Readable by
    // everyone signed in; the author, the birthday person or an admin can delete. No updates.
    match /birthdays/{uid}/wishes/{wid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && exists(/databases/$(db)/documents/birthdays/$(uid))
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'userAge', 'userAvatar', 'text', 'day', 'replyToUid', 'replyToName', 'createdAt'])
        && (request.resource.data.get('userAge', null) == null
            || (request.resource.data.userAge is int
                && request.resource.data.userAge >= 0
                && request.resource.data.userAge < 130))
        && request.resource.data.userId == me()
        && request.resource.data.createdAt == request.time
        && isDateKey(request.resource.data.day)
        && isBirthdayOn(get(/databases/$(db)/documents/birthdays/$(uid)).data.md, request.resource.data.day)
        && request.time > dateTs(request.resource.data.day) - duration.value(182, 'h')
        && request.time < dateTs(request.resource.data.day) + duration.value(38, 'h')
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 300
        && noAbuse(request.resource.data.text)
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 60
        && (request.resource.data.get('userAvatar', null) == null
            || (request.resource.data.userAvatar is string && request.resource.data.userAvatar.size() <= 60000))
        && (request.resource.data.get('replyToUid', null) == null
            || (request.resource.data.replyToUid is string && request.resource.data.replyToUid.size() <= 128))
        && (request.resource.data.get('replyToName', null) == null
            || (request.resource.data.replyToName is string && request.resource.data.replyToName.size() <= 60));
      allow delete: if signedIn()
        && (resource.data.userId == me() || uid == me() || isAdmin());
    }

    // ── "Happy birthday to all": bdayCircles/{YYYY-MM-DD}/messages/{autoId} ──
    // {userId, userName, userAvatar, type: 'text' | 'image', text, imageData, createdAt}
    // Only people whose opted-in birthday is that day, and only on that day: the circle is gone
    // (unreadable) the next day. Admins may read / delete for moderation.
    match /bdayCircles/{day}/messages/{mid} {
      allow read: if signedIn() && (myBirthdayNow(day) || isAdmin());
      allow create: if signedIn()
        && myBirthdayNow(day)
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'userAge', 'userAvatar', 'type', 'text', 'imageData', 'full', 'createdAt'])
        && request.resource.data.get('full', 1) == 1
        && (request.resource.data.get('userAge', null) == null
            || (request.resource.data.userAge is int
                && request.resource.data.userAge >= 0
                && request.resource.data.userAge < 130))
        && request.resource.data.userId == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 60
        && (request.resource.data.get('userAvatar', null) == null
            || (request.resource.data.userAvatar is string && request.resource.data.userAvatar.size() <= 60000))
        && ((request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 1000
              && noAbuse(request.resource.data.text)
              && !('imageData' in request.resource.data))
            || (request.resource.data.type == 'image'
              && request.resource.data.imageData is string
              && request.resource.data.imageData.size() <= 240000
              && !('text' in request.resource.data)));
      allow delete: if signedIn() && (resource.data.userId == me() || isAdmin());

      // ── Near-original photo (since build 115): .../messages/{mid}/media/full
      //    {imageData (JPEG <= 690 KB, ~942K chars), userId, createdAt}; the message keeps a small
      //    chat copy (+ full: 1). Written with the message in one batch, read when opened. ──
      match /media/{x} {
        allow read: if signedIn() && (myBirthdayNow(day) || isAdmin());
        allow create: if signedIn()
          && myBirthdayNow(day)
          && x == 'full'
          && getAfter(/databases/$(db)/documents/bdayCircles/$(day)/messages/$(mid)).data.userId == me()
          && request.resource.data.keys().hasOnly(['imageData', 'userId', 'createdAt'])
          && request.resource.data.userId == me()
          && request.resource.data.imageData is string
          && request.resource.data.imageData.size() <= 950000;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.userId == me() || isAdmin());
      }
    }

    // ── Activity ("who liked my photos"): users/{uid}/activity/{autoId} ──
    // {type, actorId, actorName, actorAvatar, targetKind, targetId, thumbnail, text, createdAt}
    // Written by the person who liked / disliked / commented / followed (never by the owner);
    // only the owner reads and deletes. No updates.
    match /users/{uid}/activity/{aid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create: if signedIn()
        && request.resource.data.actorId == me()
        && uid != me()
        && request.resource.data.keys().hasOnly(['type', 'actorId', 'actorName', 'actorAvatar', 'targetKind', 'targetId', 'thumbnail', 'text', 'createdAt'])
        && request.resource.data.type in ['like', 'dislike', 'comment', 'follow', 'feedback', 'referral', 'wish', 'mention']
        && request.resource.data.createdAt == request.time
        && (request.resource.data.get('actorName', null) == null
            || (request.resource.data.actorName is string && request.resource.data.actorName.size() <= 60))
        && (request.resource.data.get('actorAvatar', null) == null
            || (request.resource.data.actorAvatar is string && request.resource.data.actorAvatar.size() <= 60000))
        && (request.resource.data.get('targetKind', null) == null
            || request.resource.data.targetKind in ['post', 'wardrobe', 'birthday'])
        && (request.resource.data.get('targetId', null) == null
            || (request.resource.data.targetId is string && request.resource.data.targetId.size() <= 128))
        && (request.resource.data.get('thumbnail', null) == null
            || (request.resource.data.thumbnail is string && request.resource.data.thumbnail.size() <= 2000))
        && (request.resource.data.get('text', null) == null
            || (request.resource.data.text is string && request.resource.data.text.size() <= 120));
      allow update: if false;
    }

    // ── Push tokens (FCM): users/{uid}/pushTokens/{tokenId} {token, platform, updatedAt} ──
    // Only the owner writes / removes their phone's token; the sender job reads them with admin
    // credentials (scripts/push).
    match /users/{uid}/pushTokens/{tid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform in ['android', 'web']
        && request.resource.data.updatedAt == request.time
        && tid.matches('^t_[a-z0-9]{1,40}$');
    }

    // ── Push sender heartbeat: config/push {lastRunAt} (written only by the sender job) ──
    match /config/push {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Public list of admin uids: config/admins {uids, updatedAt} ──
    // Read by any signed-in user (feedback notifies the admins); written only by an admin
    // (AdminScreen adds the admin who opens it).
    match /config/admins {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['uids', 'updatedAt'])
        && request.resource.data.uids is list
        && request.resource.data.uids.size() <= 20
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ── Follow: users/{target}/followers/{follower} + users/{follower}/following/{target} ──
    // Only the follower writes, and both docs change together (checked with getAfter/existsAfter).
    function followEntryOk() {
      return request.resource.data.keys().hasOnly(['name', 'avatar', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && (request.resource.data.get('avatar', null) == null
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 60000));
    }
    function followPath(target, follower) {
      return /databases/$(db)/documents/users/$(target)/followers/$(follower);
    }
    function followingPath(follower, target) {
      return /databases/$(db)/documents/users/$(follower)/following/$(target);
    }
    // Lists of a private profile: only the owner (and the follower for their own doc)
    function profileOpen(uid) {
      return me() == uid
        || get(/databases/$(db)/documents/users/$(uid)).data.get('isPublic', true) != false;
    }
    match /users/{uid}/followers/{follower} {
      allow get: if signedIn() && (me() == follower || profileOpen(uid));
      allow list: if signedIn() && profileOpen(uid);
      allow create: if signedIn() && me() == follower && follower != uid
        && followEntryOk()
        && existsAfter(followingPath(follower, uid));
      allow delete: if signedIn() && me() == follower
        && !existsAfter(followingPath(follower, uid));
      allow update: if false;
    }
    match /users/{uid}/following/{target} {
      allow get: if signedIn() && (me() == uid || profileOpen(uid));
      allow list: if signedIn() && profileOpen(uid);
      allow create: if signedIn() && me() == uid && target != uid
        && followEntryOk()
        && existsAfter(followPath(target, uid));
      allow delete: if signedIn() && me() == uid
        && !existsAfter(followPath(target, uid));
      allow update: if false;
    }

    // ── "Wear today" votes on someone's wardrobe: users/{uid}/wearVotes/{date}_{voterId} ──
    // {voterId, itemId, date, updatedAt}. Like a daily vote: one doc per voter per owner per day
    // (voting for another item overwrites it). Only the voter writes their own doc; nobody votes on
    // their own clothes; only public items of an open (public) profile; only around that date.
    // Counts are readable by the owner and by anyone who can see the profile.
    match /users/{uid}/wearVotes/{vid} {
      function wearItem() {
        return get(/databases/$(db)/documents/wardrobe/$(request.resource.data.itemId)).data;
      }
      allow read: if signedIn() && (me() == uid || profileOpen(uid));
      allow create, update: if signedIn()
        && me() != uid
        && profileOpen(uid)
        && request.resource.data.keys().hasOnly(['voterId', 'itemId', 'date', 'updatedAt'])
        && request.resource.data.voterId == me()
        && isDateKey(request.resource.data.date)
        && vid == request.resource.data.date + '_' + me()
        && request.time > dateTs(request.resource.data.date) - duration.value(14, 'h')
        && request.time < dateTs(request.resource.data.date) + duration.value(38, 'h')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.itemId is string
        && request.resource.data.itemId.size() > 0
        && request.resource.data.itemId.size() <= 128
        && wearItem().userId == uid
        && wearItem().isPublic == true;
      allow delete: if signedIn() && resource.data.voterId == me();
    }

    // ── Week counter: users/{uid}/weeks/{mondayKey} {fullDays, lastDay, updatedAt} ──
    // +1 only in the same write that makes lastDay (a day of that week) fully done.
    function weekCountOk(uid, week, oldCount) {
      let day = request.resource.data.get('lastDay', '');
      return isDateKey(week) && isMonday(week) && isDateKey(day)
        && request.resource.data.keys().hasOnly(['fullDays', 'lastDay', 'updatedAt'])
        && request.resource.data.fullDays == oldCount + 1
        && dateTs(day) >= dateTs(week)
        && dateTs(day) < dateTs(week) + duration.value(7, 'd')
        && existsAfter(dayPath(uid, day))
        && fullDay(getAfter(dayPath(uid, day)).data)
        && !(exists(dayPath(uid, day)) && fullDay(get(dayPath(uid, day)).data));
    }
    match /users/{uid}/weeks/{week} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid && weekCountOk(uid, week, 0);
      allow update: if signedIn() && me() == uid
        && request.resource.data.lastDay != resource.data.get('lastDay', '')
        && weekCountOk(uid, week, resource.data.get('fullDays', 0));
      allow delete: if false;
    }

    // ── Phone registry: phones/{digits} -> {uid, createdAt} ──────────────
    // One account per mobile number. Get by id only (no listing).
    match /phones/{digits} {
      allow get: if signedIn();
      allow list: if false;
      // create() only runs when the doc doesn't exist yet
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update: if signedIn() && resource.data.uid == me()
        && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ── Daily colour votes (Phase 1) ────────────────────────────────────
    // Home writes votes/top_colors_{date}_{uid} with {systemId, color, userId, voterGender, voterName, voterAge, date, timestamp}
    match /votes/{voteId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == me()
        && request.resource.data.systemId == 'top_colors'
        && voteId == 'top_colors_' + request.resource.data.date + '_' + me()
        // Name and age shown in the Boys / Girls voter lists
        && (request.resource.data.get('voterName', null) == null
            || (request.resource.data.voterName is string && request.resource.data.voterName.size() <= 60))
        && (request.resource.data.get('voterAge', null) == null
            || (request.resource.data.voterAge is int
                && request.resource.data.voterAge >= 0
                && request.resource.data.voterAge < 130));
      allow delete: if false;
    }

    // ── Wardrobe (Phase 1) ──────────────────────────────────────────────
    match /wardrobe/{itemId} {
      allow read: if signedIn()
        && (resource.data.userId == me() || resource.data.isPublic == true);
      allow create: if signedIn() && request.resource.data.userId == me();
      allow update: if signedIn() && resource.data.userId == me()
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == me();

      // ── Likes and comments on public wardrobe photos in the feed ──
      function itemData() {
        return get(/databases/$(db)/documents/wardrobe/$(itemId)).data;
      }
      function itemVisible() {
        return itemData().userId == me() || itemData().isPublic == true;
      }
      match /likes/{likerId} {
        allow read: if signedIn() && itemVisible();
        allow create: if signedIn() && likerId == me() && itemVisible()
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if signedIn() && likerId == me();
        allow update: if false;
      }
      // ── Dislikes: one doc per user; can't be created while the user's like exists
      //    (the app removes the like in the same batch: like XOR dislike) ──
      match /dislikes/{dislikerId} {
        allow read: if signedIn() && itemVisible();
        allow create: if signedIn() && dislikerId == me() && itemVisible()
          && request.resource.data.keys().hasOnly(['createdAt'])
          && !existsAfter(/databases/$(db)/documents/wardrobe/$(itemId)/likes/$(request.auth.uid));
        allow delete: if signedIn() && dislikerId == me();
        allow update: if false;
      }
      // ── Comments: wardrobe/{id}/comments/{cid} {userId, userName, userAvatar, text, createdAt,
      //    parentId?} + replyCount/lastReplyId on top-level comments (one level of replies) ──
      match /comments/{cid} {
        function wCommentPath(x) {
          return /databases/$(db)/documents/wardrobe/$(itemId)/comments/$(x);
        }
        function replyOk() {
          let p = request.resource.data.get('parentId', null);
          return p == null
            || (p is string && p != cid
                && exists(wCommentPath(p))
                && get(wCommentPath(p)).data.get('parentId', null) == null);
        }
        function replyCountUpdate() {
          let rid = request.resource.data.lastReplyId;
          let before = resource.data.get('replyCount', 0);
          return onlyChanged(['replyCount', 'lastReplyId'])
            && rid is string
            && (
              (request.resource.data.replyCount == before + 1
                && !exists(wCommentPath(rid)) && existsAfter(wCommentPath(rid))
                && getAfter(wCommentPath(rid)).data.get('parentId', null) == cid)
              || (request.resource.data.replyCount == before - 1
                && before > 0
                && exists(wCommentPath(rid)) && !existsAfter(wCommentPath(rid))
                && get(wCommentPath(rid)).data.get('parentId', null) == cid)
            );
        }
        allow read: if signedIn() && itemVisible();
        allow create: if signedIn() && itemVisible() && commentOk() && replyOk();
        allow update: if signedIn() && itemVisible() && replyCountUpdate();
        allow delete: if signedIn()
          && (resource.data.userId == me() || itemData().userId == me() || isAdmin()
              || (resource.data.get('parentId', null) is string
                  && get(wCommentPath(resource.data.parentId)).data.userId == me()));
      }

      // ── Full-size photo: wardrobe/{id}/media/full {imageData, userId, updatedAt} ──
      // The item itself keeps only a ~200 px thumbnail (media: 1). Written by the owner in the
      // same batch as the item; read only by the detail / edit screen.
      // ── Clear feed photo: wardrobe/{id}/media/clear {imageData (~720 px, ~45 KB), userId,
      //    updatedAt} (+ clear: 1 on the item), shown full width on feed cards ──
      match /media/{mid} {
        allow read: if signedIn() && itemVisible();
        allow create, update: if signedIn() && mid in ['full', 'clear']
          && getAfter(/databases/$(db)/documents/wardrobe/$(itemId)).data.userId == me()
          && request.resource.data.keys().hasOnly(['imageData', 'userId', 'updatedAt'])
          && request.resource.data.userId == me()
          && request.resource.data.imageData is string
          // full: near-original JPEG <= 690 KB (~942K chars, build 115+); clear: ~1080 px feed copy
          && ((mid == 'full' && request.resource.data.imageData.size() <= 950000)
              || (mid == 'clear' && request.resource.data.imageData.size() <= 300000));
        // In the same batch as the item delete (get() = before the batch), or a leftover of mine
        allow delete: if signedIn()
          && (itemData().userId == me() || isAdmin() || resource.data.userId == me());
      }
    }

    // ── Invite codes: inviteCodes/{code} -> {circleId, createdBy} ──────────
    // Anyone signed in can look up one code they know; nobody can list them.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && getAfter(/databases/$(db)/documents/circles/$(request.resource.data.circleId)).data.ownerId == me()
        && getAfter(/databases/$(db)/documents/circles/$(request.resource.data.circleId)).data.inviteCode == code;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.createdBy == me() || isAdmin());
    }

    // ── Circle names: circleNames/{nameId} -> {circleId, ownerId, createdAt} ──
    // nameId = the circle's normalized name (lower case, trimmed, spaces collapsed; "/" etc.
    // %-escaped), equal to circles/{circleId}.nameKey. Created in the same transaction as the
    // circle (create / rename). A set on an existing doc is an update, which is never allowed, so
    // a taken name can't be claimed. Anyone signed in can check one name; nobody can list them.
    match /circleNames/{nameId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['circleId', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == me()
        && request.resource.data.circleId is string
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(db)/documents/circles/$(request.resource.data.circleId))
        && getAfter(/databases/$(db)/documents/circles/$(request.resource.data.circleId)).data.ownerId == me()
        && getAfter(/databases/$(db)/documents/circles/$(request.resource.data.circleId)).data.get('nameKey', '') == nameId;
      allow update: if false;
      // Owner, when the circle is gone or no longer uses this name (rename), or an admin
      allow delete: if signedIn() && (isAdmin()
        || (resource.data.ownerId == me()
            && (!existsAfter(/databases/$(db)/documents/circles/$(resource.data.circleId))
                || getAfter(/databases/$(db)/documents/circles/$(resource.data.circleId)).data.get('nameKey', '') != nameId)));
    }

    // ── Circles ─────────────────────────────────────────────────────────
    match /circles/{cid} {
      // Optional distance limit: public circles only, needs a location, 1-50 km
      function validRadius(d) {
        return d.get('radiusKm', null) == null
          || (d.radiusKm is number && d.radiusKm > 0 && d.radiusKm <= 50
              && d.isPrivate == false
              && d.get('location', null) != null
              && d.get('cosLat', null) is number);
      }
      function joinedWithCode() {
        let j = request.resource.data.get('lastJoin', {});
        return j.get('uid', '') == me() && j.get('code', '') == resource.data.inviteCode;
      }
      // Unique name: nameKey points at a circleNames doc that (after this write) belongs to this circle
      function nameDocOk(d) {
        return d.get('nameKey', null) is string
          && d.nameKey.size() > 0
          && d.nameKey.size() <= 500
          && d.get('nameLower', null) is string
          && existsAfter(/databases/$(db)/documents/circleNames/$(d.nameKey))
          && getAfter(/databases/$(db)/documents/circleNames/$(d.nameKey)).data.circleId == cid;
      }
      // Old APKs: no name-uniqueness fields at all (nameKey / nameLower absent)
      function legacyCreate(d) {
        return !d.keys().hasAny(['nameKey', 'nameLower']);
      }
      // District (Discover): optional strings; legacy docs have none
      function validDistrict(d) {
        return (d.get('district', null) == null || (d.district is string && d.district.size() <= 60))
          && (d.get('districtKey', null) == null || (d.districtKey is string && d.districtKey.size() <= 60))
          && (d.get('state', null) == null || (d.state is string && d.state.size() <= 60));
      }
      // isPublic (when present) must match isPrivate, so Discover never lists a private circle
      function visibilityOk(d) {
        return d.isPrivate is bool && d.get('isPublic', !d.isPrivate) == !d.isPrivate;
      }

      // Discover queries isPublic == true (+ districtKey); Nearby isPrivate == false (+ geohash)
      allow read: if signedIn()
        && (resource.data.isPrivate == false || resource.data.get('isPublic', false) == true
            || me() in resource.data.memberIds || isAdmin());

      allow create: if signedIn()
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()]
        && request.resource.data.isPrivate is bool
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        // Nearby: isPublic must match isPrivate; location is optional (~100 m, set by the app)
        && request.resource.data.get('isPublic', !request.resource.data.isPrivate) == !request.resource.data.isPrivate
        && (request.resource.data.get('geohash', null) == null
            || (request.resource.data.geohash is string && request.resource.data.geohash.size() <= 12))
        && (request.resource.data.get('location', null) == null
            || (request.resource.data.location.lat is number && request.resource.data.location.lng is number))
        && validRadius(request.resource.data)
        && validDistrict(request.resource.data)
        && (
          // Current builds: unique name (circleNames doc written in the same transaction).
          // Public circles carry a district (Discover); the location is optional (Nearby).
          // Build 94-era public circles carry a location instead of a district: still allowed.
          (nameDocOk(request.resource.data)
            && (request.resource.data.isPrivate == true
                || request.resource.data.get('districtKey', '') != ''
                || (request.resource.data.get('location', null) != null
                    && request.resource.data.get('geohash', null) is string)))
          // Older builds (build 93 and earlier) send no nameKey / nameLower and may create a
          // public circle without a location: still allowed so old APKs can create circles
          || legacyCreate(request.resource.data));

      allow update: if signedIn() && (
        // Owner: anything except ownership (incl. name, Public <-> Private and the Nearby location).
        // A changed name must come with its circleNames doc (same transaction).
        (resource.data.ownerId == me() && request.resource.data.ownerId == resource.data.ownerId
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'nameLower', 'nameKey'])
                || (request.resource.data.get('name', null) is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && nameDocOk(request.resource.data)))
            && visibilityOk(request.resource.data)
            && validDistrict(request.resource.data)
            && validRadius(request.resource.data))
        // Admin: only Public <-> Private and the Nearby location (isPublic must match isPrivate)
        || (isAdmin()
            && onlyChanged(['isPrivate', 'isPublic', 'location', 'geohash', 'cosLat', 'radiusKm', 'district', 'districtKey', 'state'])
            && validDistrict(request.resource.data)
            && request.resource.data.isPrivate is bool
            && request.resource.data.get('isPublic', !request.resource.data.isPrivate) == !request.resource.data.isPrivate
            && validRadius(request.resource.data))
        // Join: add only yourself.
        //   Private: only with the invite code: lastJoin = {uid: me, code: inviteCode}
        //   Public: no code needed (district / 3 km checks are done in the app); lastJoin.uid == me
        || (onlyChanged(['memberIds', 'lastJoin'])
            && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([me()].toSet())
            && (joinedWithCode()
                || (resource.data.isPrivate == false
                    && resource.data.get('isPublic', true) != false
                    && request.resource.data.get('lastJoin', {}).get('uid', '') == me())))
        // Leave: remove only yourself (the owner deletes instead of leaving)
        || (onlyChanged(['memberIds'])
            && me() in resource.data.memberIds
            && resource.data.ownerId != me()
            && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([me()].toSet()))
        // Members bump lastMessageAt when they send
        || (onlyChanged(['lastMessageAt']) && me() in resource.data.memberIds)
      );

      allow delete: if signedIn() && (resource.data.ownerId == me() || isAdmin());

      // ── Messages ──
      match /messages/{mid} {
        allow read: if isMember(cid) || isAdmin();
        allow create: if isMember(cid)
          && request.resource.data.userId == me()
          && request.resource.data.type in ['text', 'image', 'poll']
          // Photo polls (A-F picker, or up to 4 camera shots in a row): 2-6 options of
          // {imageData, label}, kind 'buy' | 'wear'. Members vote in .../votes/{uid}.
          && (request.resource.data.type != 'poll'
              || (request.resource.data.poll is map
                  && request.resource.data.poll.options is list
                  && request.resource.data.poll.options.size() >= 2
                  && request.resource.data.poll.options.size() <= 6
                  && request.resource.data.poll.get('kind', 'buy') in ['buy', 'wear']
                  && request.resource.data.poll.get('question', '') is string
                  && request.resource.data.poll.get('question', '').size() <= 100
                  && request.resource.data.poll.options[0].imageData is string
                  && request.resource.data.poll.options[1].imageData is string));
        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.userId == me() || isCircleOwner(cid) || isAdmin());

        // ── Near-original photo of an image message (since build 115):
        //    circles/{cid}/messages/{mid}/media/full {imageData (JPEG <= 690 KB, ~942K chars),
        //    userId, createdAt}; the message keeps a small chat copy (+ full: 1). Written with the
        //    message in one batch, read only when the photo is opened. ──
        match /media/{x} {
          allow read: if isMember(cid) || isAdmin();
          allow create: if isMember(cid)
            && x == 'full'
            && getAfter(/databases/$(db)/documents/circles/$(cid)/messages/$(mid)).data.userId == me()
            && request.resource.data.keys().hasOnly(['imageData', 'userId', 'createdAt'])
            && request.resource.data.userId == me()
            && request.resource.data.imageData is string
            && request.resource.data.imageData.size() <= 950000;
          allow update: if false;
          allow delete: if signedIn()
            && (resource.data.userId == me() || isCircleOwner(cid) || isAdmin());
        }

        // ── Poll votes: one doc per voter, so a new vote replaces the old one ──
        match /votes/{voterId} {
          allow read: if isMember(cid) || isAdmin();
          // 24-hour polls (src/utils/pollWindow.ts): votes only within 24 h of the poll's createdAt
          allow create, update: if isMember(cid)
            && voterId == me()
            && request.time < get(/databases/$(db)/documents/circles/$(cid)/messages/$(mid)).data.get('createdAt', request.time + duration.value(1, 'm')) + duration.value(24, 'h')
            && request.resource.data.keys().hasOnly(['optionIndex', 'updatedAt'])
            && request.resource.data.optionIndex is int
            && request.resource.data.optionIndex >= 0
            && request.resource.data.optionIndex
               < get(/databases/$(db)/documents/circles/$(cid)/messages/$(mid)).data.poll.options.size();
          // Own vote, or cleanup by the poll author, circle owner or admin
          allow delete: if signedIn()
            && (voterId == me()
                || isCircleOwner(cid)
                || isAdmin()
                || get(/databases/$(db)/documents/circles/$(cid)/messages/$(mid)).data.userId == me());
        }

        // ── Like / dislike: one doc per member, changeable ──
        match /reactions/{uid} {
          allow read: if isMember(cid) || isAdmin();
          allow create, update: if isMember(cid)
            && uid == me()
            && request.resource.data.keys().hasOnly(['type', 'updatedAt'])
            && request.resource.data.type in ['like', 'dislike'];
          allow delete: if signedIn()
            && (uid == me()
                || isCircleOwner(cid)
                || isAdmin()
                || get(/databases/$(db)/documents/circles/$(cid)/messages/$(mid)).data.userId == me());
        }

        // ── Comments on a photo / A-F post ──
        match /comments/{commentId} {
          allow read: if isMember(cid) || isAdmin();
          allow create: if isMember(cid) && commentOk();
          allow update: if false;
          allow delete: if signedIn()
            && (resource.data.userId == me()
                || isCircleOwner(cid)
                || isAdmin()
                || get(/databases/$(db)/documents/circles/$(cid)/messages/$(mid)).data.userId == me());
        }
      }
    }

    // ── Public feed ─────────────────────────────────────────────────────
    match /posts/{postId} {
      function postPath() {
        return /databases/$(db)/documents/posts/$(postId);
      }
      function likePath() {
        return /databases/$(db)/documents/posts/$(postId)/likes/$(request.auth.uid);
      }
      function commentPath(cid) {
        return /databases/$(db)/documents/posts/$(postId)/comments/$(cid);
      }
      // likeCount changes by exactly 1, together with the liker's own like doc
      function likeUpdate() {
        return onlyChanged(['likeCount'])
          && (
            (request.resource.data.likeCount == resource.data.likeCount + 1
              && !exists(likePath()) && existsAfter(likePath()))
            || (request.resource.data.likeCount == resource.data.likeCount - 1
              && exists(likePath()) && !existsAfter(likePath()))
          );
      }
      // commentCount changes by exactly 1, together with the comment named in lastCommentId
      // (posts without commentCount count as 0)
      function commentCountUpdate() {
        let cid = request.resource.data.lastCommentId;
        let before = resource.data.get('commentCount', 0);
        return onlyChanged(['commentCount', 'lastCommentId'])
          && cid is string
          && (
            (request.resource.data.commentCount == before + 1
              && !exists(commentPath(cid)) && existsAfter(commentPath(cid)))
            || (request.resource.data.commentCount == before - 1
              && before > 0
              && exists(commentPath(cid)) && !existsAfter(commentPath(cid)))
          );
      }

      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == me()
        && request.resource.data.isPublic == true
        && request.resource.data.likeCount == 0
        && request.resource.data.get('commentCount', 0) == 0
        && request.resource.data.imageData is string
        // 2-6 photo "vote A/B/C" posts keep photos B.. in morePhotos
        && (request.resource.data.get('morePhotos', null) == null
            || (request.resource.data.morePhotos is list
                && request.resource.data.morePhotos.size() >= 1
                && request.resource.data.morePhotos.size() <= 5));
      allow update: if signedIn() && (likeUpdate() || commentCountUpdate());
      allow delete: if signedIn() && (resource.data.userId == me() || isAdmin());

      match /likes/{likerId} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && likerId == me();
        allow update: if false;
      }

      // ── Dislikes: one doc per user; can't be created while the user's like exists
      //    (the app removes the like + likeCount in the same transaction: like XOR dislike) ──
      match /dislikes/{dislikerId} {
        allow read: if signedIn();
        allow create: if signedIn() && dislikerId == me()
          && exists(postPath())
          && request.resource.data.keys().hasOnly(['createdAt'])
          && !existsAfter(likePath());
        allow delete: if signedIn() && dislikerId == me();
        allow update: if false;
      }

      // ── A/B/C votes on multi-photo posts: one doc per voter, changeable ──
      match /votes/{voterId} {
        function photoCount() {
          return get(postPath()).data.get('morePhotos', []).size() + 1;
        }
        allow read: if signedIn();
        allow create, update: if signedIn()
          && voterId == me()
          && request.resource.data.keys().hasOnly(['option', 'updatedAt'])
          && photoCount() >= 2
          && request.resource.data.option in ['A', 'B', 'C', 'D', 'E', 'F'][0:photoCount()];
        allow delete: if signedIn() && (voterId == me() || get(postPath()).data.userId == me() || isAdmin());
      }

      // ── Full-size photos: posts/{postId}/media/full {photos: [A, B...], userId, createdAt} ──
      // The post keeps ~200 px thumbnails (media: 1); written by the author in the same batch
      // as the post, read only on the detail screen. When the near-original photos (build 115+)
      // don't fit one doc together, each is in media/full0..full5 {imageData, userId, createdAt}
      // and the post has media: 2.
      // ── Clear feed photos: posts/{postId}/media/clear {photos: [~720 px A, B...], userId,
      //    createdAt} (+ clear: 1 on the post), shown full width on feed cards ──
      match /media/{mid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && getAfter(postPath()).data.userId == me()
          && request.resource.data.userId == me()
          && ((mid in ['full', 'clear']
                && request.resource.data.keys().hasOnly(['photos', 'userId', 'createdAt'])
                && request.resource.data.photos is list
                && request.resource.data.photos.size() >= 1
                && request.resource.data.photos.size() <= 6)
              // media: 2 posts (build 115+): one near-original photo per doc, full0..full5
              || (mid in ['full0', 'full1', 'full2', 'full3', 'full4', 'full5']
                && request.resource.data.keys().hasOnly(['imageData', 'userId', 'createdAt'])
                && request.resource.data.imageData is string
                && request.resource.data.imageData.size() <= 950000));
        allow update: if false;
        // With the post delete (get() = before the batch), or a leftover of mine
        allow delete: if signedIn()
          && (get(postPath()).data.userId == me() || isAdmin() || resource.data.userId == me());
      }

      // ── Comments: posts/{postId}/comments/{cid} {userId, userName, userAvatar, text, createdAt,
      //    parentId?} + replyCount/lastReplyId on top-level comments (one level of replies) ──
      match /comments/{cid} {
        // A reply points at an existing TOP-LEVEL comment of this post (no replyCount on create)
        function replyOk() {
          let p = request.resource.data.get('parentId', null);
          return p == null
            || (p is string && p != cid
                && exists(commentPath(p))
                && get(commentPath(p)).data.get('parentId', null) == null);
        }
        // replyCount changes by exactly 1, together with the reply named in lastReplyId
        function replyCountUpdate() {
          let rid = request.resource.data.lastReplyId;
          let before = resource.data.get('replyCount', 0);
          return onlyChanged(['replyCount', 'lastReplyId'])
            && rid is string
            && (
              (request.resource.data.replyCount == before + 1
                && !exists(commentPath(rid)) && existsAfter(commentPath(rid))
                && getAfter(commentPath(rid)).data.get('parentId', null) == cid)
              || (request.resource.data.replyCount == before - 1
                && before > 0
                && exists(commentPath(rid)) && !existsAfter(commentPath(rid))
                && get(commentPath(rid)).data.get('parentId', null) == cid)
            );
        }
        allow read: if signedIn();
        allow create: if signedIn()
          && exists(postPath())
          && commentOk()
          && replyOk();
        allow update: if signedIn() && replyCountUpdate();
        // Comment author, post owner, admin, or (for a reply) the parent comment's author
        allow delete: if signedIn()
          && (resource.data.userId == me()
              || get(postPath()).data.userId == me()
              || isAdmin()
              || (resource.data.get('parentId', null) is string
                  && get(commentPath(resource.data.parentId)).data.userId == me()));
      }
    }

    // ── Referral codes: referralCodes/{code} -> {uid, createdAt} (one per user) ──
    match /referralCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == me()
        && getAfter(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('referralCode', '') == code;
      allow update, delete: if false;
    }

    // ── Referrals: referrals/{newUid} {referrerId, code, createdAt, pointsAwarded}, written once by
    // the new user, together with +50 on users/{referrerId}.points (see the users rule).
    match /referrals/{newUid} {
      allow get: if signedIn() && (me() == newUid || resource.data.referrerId == me());
      allow list: if signedIn() && resource.data.referrerId == me();
      allow create: if signedIn() && me() == newUid
        && request.resource.data.keys().hasOnly(['referrerId', 'code', 'createdAt', 'pointsAwarded'])
        // pointsAwarded: true only when the referrer's points go up by 50 in the same write
        && (request.resource.data.get('pointsAwarded', false) == false
            || (request.resource.data.pointsAwarded == true
                && getAfter(/databases/$(db)/documents/users/$(request.resource.data.referrerId)).data.get('points', 0)
                   == get(/databases/$(db)/documents/users/$(request.resource.data.referrerId)).data.get('points', 0) + 50))
        && request.resource.data.referrerId is string
        && request.resource.data.referrerId != me()
        && request.resource.data.code is string
        && request.resource.data.createdAt == request.time
        && get(/databases/$(db)/documents/referralCodes/$(request.resource.data.code)).data.uid
           == request.resource.data.referrerId
        // only right after sign-up
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.createdAt
           > request.time - duration.value(1, 'd');
      allow update, delete: if false;
    }

    // ── Weekly celebrities: weeklyStars/{mondayKey}/members/{uid} ──
    match /weeklyStars/{week} {
      match /members/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && me() == uid
          && isDateKey(week) && isMonday(week)
          && request.resource.data.keys().hasOnly(['name', 'avatar', 'completedDays', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 60
          && (request.resource.data.get('avatar', null) == null
              || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 60000))
          && request.resource.data.createdAt == request.time
          && request.resource.data.completedDays is int
          && request.resource.data.completedDays
             == get(/databases/$(db)/documents/users/$(request.auth.uid)/weeks/$(week)).data.fullDays
          && request.resource.data.completedDays >= weeklyRequiredDays();
        allow update: if false;
        allow delete: if signedIn() && (me() == uid || isAdmin());
      }
    }

    // ── Reports (moderation) ────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == me()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ── Feedback & suggestions board ────────────────────────────────────
    // feedback/{fid} {uid, name, type, text, image, appVersion, platform, createdAt, status,
    //   isPublic, likeCount, replyCount, lastReplyId, quoteOf: {id, uid, name, text}, editedAt}
    //   feedback/{fid}/likes/{uid}       one like per user, likeCount changes in the same write
    //   feedback/{fid}/replies/{rid}     {uid, name, text, createdAt, editedAt}, replyCount likewise
    // Signed-in users read public feedback (isPublic == true); authors read their own; admins
    // (users.role 'admin' or listed in config/admins) read ALL and change status. Authors may only
    // edit / delete their own feedback and replies. Feedback written before the board has no
    // isPublic, so it stays admin + author only.
    function listedAdmin() {
      return signedIn()
        && me() in get(/databases/$(db)/documents/config/admins).data.get('uids', []);
    }
    function feedbackAdmin() {
      return isAdmin() || listedAdmin();
    }
    // Same worst-words check as comments (the app filters a longer list before sending)
    function feedbackTextOk(t, max) {
      return t is string && t.size() >= 1 && t.size() <= max
        && !t.lower().matches('(([a-z]|[^a-z])*[^a-z])?(fuck[a-z]*|motherfucker[a-z]*|bitch(es)?|cunts?|nigg(er|a)s?|faggots?|madarchod|behenchod|bhenchod|chutiy[ae]|bhosdike|lanja|lanjakodaka|dengu|puku|modda|randi|gandu|lavda)([^a-z]([a-z]|[^a-z])*)?');
    }
    function feedbackPath(fid) {
      return /databases/$(db)/documents/feedback/$(fid);
    }
    function canSeeFeedback(fid) {
      return signedIn()
        && (get(feedbackPath(fid)).data.get('isPublic', false) == true
            || get(feedbackPath(fid)).data.uid == me()
            || feedbackAdmin());
    }
    function quoteOk(d) {
      return d.get('quoteOf', null) == null
        || (d.quoteOf is map
            && d.quoteOf.keys().hasOnly(['id', 'uid', 'name', 'text'])
            && d.quoteOf.id is string
            && d.quoteOf.text is string && d.quoteOf.text.size() <= 220
            && d.quoteOf.get('name', '') is string && d.quoteOf.get('name', '').size() <= 80
            && exists(feedbackPath(d.quoteOf.id))
            && get(feedbackPath(d.quoteOf.id)).data.uid == d.quoteOf.get('uid', '')
            && canSeeFeedback(d.quoteOf.id));
    }

    match /feedback/{fid} {
      function likePathF() {
        return /databases/$(db)/documents/feedback/$(fid)/likes/$(request.auth.uid);
      }
      function replyPathF(rid) {
        return /databases/$(db)/documents/feedback/$(fid)/replies/$(rid);
      }
      function visible() {
        return resource.data.isPublic == true || resource.data.uid == me() || feedbackAdmin();
      }
      // likeCount changes by exactly 1, together with my own like doc
      function feedbackLikeUpdate() {
        let before = resource.data.get('likeCount', 0);
        return onlyChanged(['likeCount'])
          && ((request.resource.data.likeCount == before + 1 && !exists(likePathF()) && existsAfter(likePathF()))
              || (request.resource.data.likeCount == before - 1 && before > 0
                  && exists(likePathF()) && !existsAfter(likePathF())));
      }
      // replyCount changes by exactly 1, together with the reply named in lastReplyId
      function feedbackReplyCountUpdate() {
        let rid = request.resource.data.lastReplyId;
        let before = resource.data.get('replyCount', 0);
        return onlyChanged(['replyCount', 'lastReplyId'])
          && rid is string
          && ((request.resource.data.replyCount == before + 1 && !exists(replyPathF(rid)) && existsAfter(replyPathF(rid)))
              || (request.resource.data.replyCount == before - 1 && before > 0
                  && exists(replyPathF(rid)) && !existsAfter(replyPathF(rid))));
      }

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'type', 'text', 'image', 'appVersion', 'platform', 'createdAt', 'status', 'isPublic', 'likeCount', 'replyCount', 'quoteOf'])
        && request.resource.data.keys().hasAll(['uid', 'type', 'text', 'createdAt', 'status'])
        && request.resource.data.uid == me()
        && request.resource.data.type in ['Suggestion', 'Complaint', 'Bug', 'Other']
        && feedbackTextOk(request.resource.data.text, 1000)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('isPublic', false) is bool
        && request.resource.data.get('likeCount', 0) == 0
        && request.resource.data.get('replyCount', 0) == 0
        && (request.resource.data.get('name', null) == null
            || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
        && (request.resource.data.get('image', null) == null
            || (request.resource.data.image is string && request.resource.data.image.size() <= 145000))
        && (request.resource.data.get('appVersion', null) == null
            || (request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20))
        && (request.resource.data.get('platform', null) == null
            || (request.resource.data.platform is string && request.resource.data.platform.size() <= 20))
        && quoteOk(request.resource.data);
      // Queries: the board asks for isPublic == true, "Mine" for uid == me, admins for everything
      allow read: if signedIn() && visible();
      allow update: if signedIn() && (
        // Author: text / type / board visibility only
        (resource.data.uid == me()
            && onlyChanged(['text', 'type', 'isPublic', 'editedAt'])
            && feedbackTextOk(request.resource.data.text, 1000)
            && request.resource.data.type in ['Suggestion', 'Complaint', 'Bug', 'Other']
            && request.resource.data.get('isPublic', false) is bool
            && request.resource.data.editedAt == request.time)
        // Admin: status
        || (feedbackAdmin()
            && onlyChanged(['status'])
            && request.resource.data.status in ['new', 'read', 'done'])
        // Anyone who can see it: like counter / reply counter (checked against the sub-docs)
        || (visible() && (feedbackLikeUpdate() || feedbackReplyCountUpdate()))
      );
      allow delete: if signedIn() && (resource.data.uid == me() || feedbackAdmin());

      // ── Likes: doc id = liker, so one like per user ──
      match /likes/{likerId} {
        allow read: if canSeeFeedback(fid);
        allow create: if canSeeFeedback(fid)
          && likerId == me()
          && request.resource.data.keys().hasOnly(['createdAt'])
          && getAfter(feedbackPath(fid)).data.get('likeCount', 0)
             == get(feedbackPath(fid)).data.get('likeCount', 0) + 1;
        allow update: if false;
        // Unlike (with the counter), or cleanup when the feedback is deleted by its author / an admin
        allow delete: if signedIn() && (
          (likerId == me()
              && (!existsAfter(feedbackPath(fid))
                  || getAfter(feedbackPath(fid)).data.get('likeCount', 0)
                     == get(feedbackPath(fid)).data.get('likeCount', 0) - 1))
          || get(feedbackPath(fid)).data.uid == me()
          || feedbackAdmin());
      }

      // ── Replies ──
      match /replies/{rid} {
        allow read: if canSeeFeedback(fid);
        allow create: if canSeeFeedback(fid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == me()
          && request.resource.data.createdAt == request.time
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && feedbackTextOk(request.resource.data.text, 500)
          && getAfter(feedbackPath(fid)).data.get('lastReplyId', '') == rid;
        // Author edits the text only
        allow update: if signedIn()
          && resource.data.uid == me()
          && onlyChanged(['text', 'editedAt'])
          && feedbackTextOk(request.resource.data.text, 500)
          && request.resource.data.editedAt == request.time;
        // Reply author (with the counter), feedback author or admin
        allow delete: if signedIn() && (
          (resource.data.uid == me()
              && (!existsAfter(feedbackPath(fid))
                  || getAfter(feedbackPath(fid)).data.get('lastReplyId', '') == rid))
          || get(feedbackPath(fid)).data.uid == me()
          || feedbackAdmin());
      }
    }
    // ── Reward claims: rewardClaims/{uid}_{YYYY-MM}_{rewardId} ──
    // {uid, name, rewardId, title, cost, month, status, createdAt, decidedAt?, decidedBy?}
    // Created 'pending' by the user together with users.coinsSpent += cost (coinsSpentOk);
    // only an admin moves it to approved / rejected (rejected also refunds, see users rules).
    match /rewardClaims/{cid} {
      allow read: if signedIn() && (resource.data.uid == me() || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'rewardId', 'title', 'cost', 'month', 'status', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && cid == me() + '_' + request.resource.data.month + '_' + request.resource.data.rewardId
        && request.resource.data.cost == rewardCost(request.resource.data.rewardId)
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && getAfter(/databases/$(db)/documents/users/$(me())).data.get('rewardClaim', '') == cid
        && getAfter(/databases/$(db)/documents/users/$(me())).data.get('coinsSpent', 0)
            == get(/databases/$(db)/documents/users/$(me())).data.get('coinsSpent', 0) + request.resource.data.cost;
      allow update: if signedIn() && isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && onlyChanged(['status', 'decidedAt', 'decidedBy'])
        && request.resource.data.decidedBy == me()
        && request.resource.data.decidedAt == request.time
        && (request.resource.data.status == 'approved'
            || getAfter(/databases/$(db)/documents/users/$(resource.data.uid)).data.get('refundClaim', '') == cid);
      allow delete: if false;
    }
  }
}
